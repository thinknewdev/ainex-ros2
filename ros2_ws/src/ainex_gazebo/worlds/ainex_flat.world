<?xml version="1.0" ?>
<!--
  Flat world for the AiNex simulation (Gazebo Classic 11, ROS2 Humble).
  Based on the vendor empty.world plus a fixed observer camera ~1.5 m from the
  robot spawn point (robot spawns at origin), publishing
  /sim_camera/image_raw (sensor_msgs/Image, 640x480 @ 15 fps) for the dashboard.

  Physics: vendor used max_step_size 0.01 @ 1000 Hz (10x realtime target);
  changed to 0.001 @ 1000 Hz for a stable 1x realtime with the 200 Hz
  controller_manager.
-->
<sdf version="1.6">
  <world name="default">
    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <physics name="default_physics" default="0" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Fixed dashboard camera: 1.5 m in front of the spawn point, slightly
         above robot head height, looking back at the origin. -->
    <model name="sim_camera">
      <static>true</static>
      <pose>1.15 0 0.55 0 0.42 3.14159</pose>
      <link name="sim_camera_link">
        <visual name="camera_body">
          <geometry>
            <box><size>0.04 0.08 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.1 0.1 0.1 1</ambient>
            <diffuse>0.15 0.15 0.15 1</diffuse>
          </material>
        </visual>
        <sensor name="sim_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>15.0</update_rate>
          <visualize>false</visualize>
          <camera>
            <horizontal_fov>1.085595</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>50</far>
            </clip>
          </camera>
          <plugin name="sim_camera_controller" filename="libgazebo_ros_camera.so">
            <!-- Topics: /<camera_name>/image_raw and /<camera_name>/camera_info -->
            <camera_name>sim_camera</camera_name>
            <frame_name>sim_camera_link</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
